# Copy this file to .env and set your server-side Gemini API key
GEMINI_API_KEY=

# Risky fallback for static hosting only. This key is public in client bundle.
# Lock it down with strict HTTP referrer + API restrictions.
VITE_PUBLIC_GEMINI_API_KEY=

# Optional client-side Sentry DSN for error monitoring
VITE_SENTRY_DSN=
