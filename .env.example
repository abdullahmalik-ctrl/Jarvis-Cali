# Copy this file to .env and set your server-side Gemini API key
GEMINI_API_KEY=

# Optional backend URL for production if your API server is hosted separately.
# Example: https://your-api.example.com
VITE_BACKEND_PROXY_BASE=

# Risky static-site fallback key (public in built JS). Use only if you accept exposure.
# Lock down with strict HTTP referrer + API restrictions + low quota.
VITE_PUBLIC_GEMINI_API_KEY=

# Optional client-side Sentry DSN for error monitoring
VITE_SENTRY_DSN=
